{% extends "base.html.twig" %}

{% block title %}
    Content | {{ site.name }}
{% endblock %}

{% block content %}

<section class="content-list">

    <header class="page-header">
        <h1>Content</h1>
    </header>

    {% for category, pages in categories %}

        <section class="content-category">

            <h2>{{ category|title }}</h2>

            <ul class="content-list">

                {% for page in pages %}

                    <li class="content-list-item">

                        <div>
                            <a href="{{ site.baseurl }}/{{ page.slug }}.html">
                                {{ page.title }}
                            </a>

                            {% if page.date %}
                                <time datetime="{{ page.date.format('c') }}">
                                    {{ page.date.format('F j, Y') }}
                                </time>
                            {% endif %}
                        </div>

                    </li>

                {% endfor %}

            </ul>

        </section>

    {% else %}

        <p>No content found.</p>

    {% endfor %}

</section>

{% endblock %}

