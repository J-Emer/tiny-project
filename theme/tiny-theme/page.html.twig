{% extends 'base.html.twig' %}

{% block content %}

<article class="page">

    <header class="page-header">


        <img src="{{ images(page.thumb) }}" alt="" srcset="">

        <h1>{{ page.title }}</h1>


        {% if page.date %}
            <time datetime="{{ page.date|date('Y-m-d') }}">
                {{ page.date|date('F j, Y') }}
            </time>
        {% endif %}

    </header>

    <div class="content">

        {{ page.content|raw }}

    </div>

</article>

{% endblock %}