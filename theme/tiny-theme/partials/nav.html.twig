<nav class="site-nav">

    <button
        class="nav-toggle"
        type="button"
        aria-label="Toggle navigation"
        onclick="document.querySelector('.site-nav').classList.toggle('open')"
    >
        <span></span>
        <span></span>
        <span></span>
    </button>

    <ul>

        {% for item in navigation %}

            <li>

                <a
                    href="{{ item.url }}"
                    {% if item.slug == current %}
                        class="active"
                    {% endif %}
                >
                    {{ item.title }}
                </a>

            </li>

        {% endfor %}

    </ul>

</nav>