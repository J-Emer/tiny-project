{% extends "base.html.twig" %}

{% block title %}
    {{ page.title }} | {{ site.site.name }}
{% endblock %}

{% block content %}

<main>

    <article>

        <header>
            <h1>{{ page.title }}</h1>

            <time datetime="{{ page.date.format('c') }}">
                {{ page.date.format('F j, Y') }}
            </time>
        </header>

        <div class="content">
            {{ page.content|raw }}
        </div>

    </article>

</main>

{% endblock %}

